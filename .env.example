# Stable generated instance key, min 48 characters; retain for tokens and full export/import.
READECK_SECRET_KEY=
# Initial private owner username; keep stable to avoid creating an additional administrator.
READECK_OWNER_USERNAME=owner
# Generated private initial password, min 16 characters; not reset for existing users.
READECK_OWNER_PASSWORD=
# REQUIRED owner mailbox; SMTP is not included, password reset email needs separate setup.
READECK_OWNER_EMAIL=
# Canonical HTTPS origin for links and secure cookies.
READECK_SERVER_BASE_URL=http://localhost:18318
# Comma-separated approved hostnames (no ports); include Railway healthcheck host.
READECK_ALLOWED_HOSTS=localhost,127.0.0.1
# Two in-process extraction workers; no separate shared-volume worker.
READECK_WORKER_NUMBER=2
# Public bearer share-link lifetime in hours; shares are opt-in and are not authentication.
READECK_PUBLIC_SHARE_TTL=1
# Local-only loopback port; choose 18300–18349.
LOCAL_PORT=18318
